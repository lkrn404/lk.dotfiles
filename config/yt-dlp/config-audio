# New format syntax
# Audio only mode
-f bestvideo*+bestaudio/best
-x

# Do not copy the mtime
--no-mtime

-o "%(upload_date>%Y-%m-%d)s - %(title)s.%(ext)s"

# Alternative option that does not make a folder
